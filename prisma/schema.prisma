generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Property {
  id             Int       @id @default(autoincrement())
  title          String
  slug           String    @unique
  operation      String
  propertyType   String
  status         String    @default("published")
  featured       Boolean   @default(false)
  price          Float?
  currency       String    @default("USD")
  expenses       Float?
  address        String?
  neighborhood   String?
  city           String?
  province       String    @default("Ciudad Autónoma de Buenos Aires")
  description    String?
  totalArea      Float?
  coveredArea    Float?
  rooms          Int?
  bedrooms       Int?
  bathrooms      Int?
  garages        Int?
  age            Int?
  amenities      String?
  images         String?
  videoUrl       String?
  externalUrl    String?
  externalSource String?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  inquiries      Inquiry[]
  leads          Lead[]
}

model Inquiry {
  id                 Int       @id @default(autoincrement())
  name               String
  phone              String?
  email              String
  message            String?
  type               String    @default("contact")
  propertyId         Int?
  property           Property? @relation(fields: [propertyId], references: [id])
  read               Boolean   @default(false)
  notificationStatus String    @default("pending")
  notificationError  String?
  notifiedAt         DateTime?
  leadId             Int?
  lead               Lead?     @relation(fields: [leadId], references: [id])
  createdAt          DateTime  @default(now())
}

model Lead {
  id           Int           @id @default(autoincrement())
  name         String
  email        String
  phone        String?
  source       String        @default("web")
  stage        String        @default("nuevo")
  priority     String        @default("media")
  notes        String?
  assignedTo   String?
  propertyId   Int?
  property     Property?     @relation(fields: [propertyId], references: [id])
  inquiries    Inquiry[]
  interactions Interaction[]
  tags         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Interaction {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  notes     String
  createdBy String?
  createdAt DateTime @default(now())
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  name     String?
}
