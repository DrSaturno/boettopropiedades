# Local development uses this SQLite file through Prisma.
DATABASE_URL="file:./dev.db"

# Production database (Turso). When set, it replaces the local SQLite file.
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="replace-with-turso-token"

NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="https://www.boettopropiedades.com"
NEXT_PUBLIC_SITE_URL="https://www.boettopropiedades.com"
ADMIN_EMAIL="admin@boettopropiedades.com.ar"
ADMIN_PASSWORD="replace-with-a-secure-password"

# Inquiry notifications
SMTP_HOST="mail.boettopropiedades.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@boettopropiedades.com"
SMTP_PASS="smtp-password"
SMTP_FROM="Boetto Propiedades <info@boettopropiedades.com>"
INQUIRY_EMAIL_TO="info@boettopropiedades.com"

# Property images (Vercel Blob). Vercel adds this variable when the store is connected.
BLOB_READ_WRITE_TOKEN=""

# Optional: show fictional sample listings only while the database has no published properties.
CATALOG_DEMO_MODE="false"

# Optional alternative image storage (Supabase), server-side only
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_STORAGE_BUCKET="property-images"
SUPABASE_STORAGE_ENABLED="false"
